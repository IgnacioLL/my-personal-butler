# OpenClaw Gateway — VPS environment template.
# Copy to deploy/.env and fill in values. Never commit .env.

# --- Image (official pre-built; pin a release tag in production) ---
OPENCLAW_IMAGE=ghcr.io/openclaw/openclaw:latest
# Alternatives:
# OPENCLAW_IMAGE=openclaw/openclaw:latest
# OPENCLAW_IMAGE=ghcr.io/openclaw/openclaw:2026.2.26

# --- Gateway auth (required for non-loopback / remote access) ---
# Generate: openssl rand -hex 32
OPENCLAW_GATEWAY_TOKEN=

# --- Bind / ports ---
# lan = listen on all interfaces inside container; use loopback host mapping below.
OPENCLAW_GATEWAY_BIND=lan
OPENCLAW_GATEWAY_PORT=18789
OPENCLAW_BRIDGE_PORT=18790
# Keep 127.0.0.1 on the host unless you have firewall + TLS in front.
OPENCLAW_GATEWAY_BIND_ADDR=127.0.0.1
OPENCLAW_BRIDGE_BIND_ADDR=127.0.0.1

# --- Persistent host paths (~/.openclaw style) ---
OPENCLAW_CONFIG_DIR=/root/.openclaw
OPENCLAW_WORKSPACE_DIR=/root/.openclaw/workspace
OPENCLAW_AUTH_PROFILE_SECRET_DIR=/root/.openclaw-auth-profile-secrets

# --- personal-agent repo checkout (skills, production config, data/) ---
PERSONAL_AGENT_REPO=/opt/personal-agent

# --- Timezone (IANA name) ---
OPENCLAW_TZ=Europe/Madrid

# --- mDNS (disable on headless VPS) ---
OPENCLAW_DISABLE_BONJOUR=1

# --- Optional provider session keys (prefer auth-profiles.json after onboard) ---
# CLAUDE_AI_SESSION_KEY=
# CLAUDE_WEB_SESSION_KEY=
# CLAUDE_WEB_COOKIE=
