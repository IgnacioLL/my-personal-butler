# Production STT + TTS secrets — copy to voice.local.env (never commit).
# Loaded by the OpenClaw Gateway process / Docker Compose env_file.
# See docs/production-voice.md and agent-plan/intelligence/transcription.md.

# --- OpenAI (primary STT + TTS) ---
# Used by tools.media.audio.models (gpt-4o-transcribe / gpt-4o-mini-transcribe)
# and messages.tts.providers.openai (gpt-4o-mini-tts).
OPENAI_API_KEY=

# Optional: override OpenAI TTS base URL (OpenAI-compatible servers allowed).
# OPENAI_TTS_BASE_URL=https://api.openai.com/v1

# --- Optional ElevenLabs TTS fallback (not required for v1 inbound mode) ---
# ELEVENLABS_API_KEY=
# XI_API_KEY=

# --- Optional MiniMax TTS fallback ---
# MINIMAX_API_KEY=
# MINIMAX_TTS_MODEL=speech-2.8-hd
# MINIMAX_TTS_VOICE_ID=English_expressive_narrator

# --- Whisper CLI fallback (local binary; no API key) ---
# Install whisper on the Gateway host, then merge
# config/production/openclaw.voice.whisper-fallback.json into openclaw.json.
# WHISPER_MODEL=base

# --- Harness / CI (do not set these in production) ---
# STT_PROVIDER=fixture   # CI default — SttStub + fixtures/audio
# STT_PROVIDER=openai    # production intent only; live calls never in test:ci
