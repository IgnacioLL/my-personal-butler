# Production voice-call (Twilio / Telnyx) secrets — copy to voice-call.local.env
# (never commit). Load via Gateway env_file / Docker Compose.
# Docs: docs/voice-calls.md · agent-plan/channels/voice-calls.md
# OpenClaw plugin: https://docs.openclaw.ai/plugins/voice-call

# --- Provider selection ---
# mock = CI / local (no carrier). twilio | telnyx = production.
VOICE_CALL_PROVIDER=twilio

# Dedicated outbound number (E.164) purchased on Twilio/Telnyx.
VOICE_CALL_FROM_NUMBER=+15550001234

# Operator handset — only this number is dialed for v1 outbound.
VOICE_CALL_TO_NUMBER=+15550005678

# Comma-separated E.164 outbound allowlist (must include VOICE_CALL_TO_NUMBER).
VOICE_CALL_OUTBOUND_ALLOWLIST=+15550005678

# --- Public webhook (required for Twilio/Telnyx; unused for mock) ---
# Must be HTTPS and reachable by the carrier. Prefer Gateway public_url + path.
# Example: https://gateway.example.com/voice/webhook
VOICE_CALL_PUBLIC_URL=https://gateway.example.com/voice/webhook
VOICE_CALL_WEBHOOK_PATH=/voice/webhook
VOICE_CALL_WEBHOOK_PORT=3334

# --- Twilio ---
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=
# Optional override; defaults to VOICE_CALL_FROM_NUMBER.
# TWILIO_FROM_NUMBER=+15550001234
# Optional region: us1 | ie1 | au1
# TWILIO_REGION=us1

# --- Telnyx (alternative to Twilio) ---
# TELNYX_API_KEY=
# TELNYX_CONNECTION_ID=
# Ed25519 public key (Base64) from Mission Control — required for webhook verify.
# TELNYX_PUBLIC_KEY=

# --- Safety (production defaults) ---
# Never enable signature skip outside local tunnel debugging.
VOICE_CALL_SKIP_SIGNATURE_VERIFICATION=0
VOICE_CALL_INBOUND_POLICY=disabled
VOICE_CALL_MAX_DURATION_SECONDS=300
VOICE_CALL_MAX_CONCURRENT=1

# --- Harness / CI (do not set these in production) ---
# VOICE_CALL_PROVIDER=mock
