# Google Calendar OAuth secrets — PROD-06
# Copy to calendar.local.env (gitignored) and fill in. Never commit real values.
#
# Operator setup:
#   1. Google Cloud Console → create OAuth client (Desktop or Web)
#   2. Enable Google Calendar API
#   3. Run offline consent once to obtain a refresh_token
#   4. cp config/production/calendar.env.example config/production/calendar.local.env
#   5. Fill values below; set CALENDAR_MODE=google
#   6. Keep CALENDAR_LIVE unset until soft-confirm path is verified dry-run
#   7. Set CALENDAR_LIVE=1 only when ready for real writes
#
# Docs: docs/calendar-production.md
# Config: config/production/calendar.json
# Skill: src/skills/calendar/SKILL.md

# Backend selection (default memory = harness stub)
CALENDAR_MODE=google
CALENDAR_PROFILE=./config/production/calendar.json

# Live writes (default off — dry-run shapes payloads + local mirror only)
# CALENDAR_LIVE=1

# OAuth client (Desktop app recommended for personal refresh tokens)
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REFRESH_TOKEN=

# Optional short-lived access token (adapter refreshes via refresh_token)
# GOOGLE_CALENDAR_ACCESS_TOKEN=

# Optional token JSON file written by your OAuth helper (still gitignored)
# GOOGLE_CALENDAR_TOKEN_FILE=./data/secrets/google-calendar-token.json

# Calendar to write (default primary)
GOOGLE_CALENDAR_ID=primary
GOOGLE_CALENDAR_TIMEZONE=Europe/Madrid
