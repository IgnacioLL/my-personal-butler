# Harness / Virtual User flags for CI and local test runs.
# Copy to harness.local.env — never commit real tokens.

HARNESS_FAKE_CLOCK=1
HARNESS_GATEWAY_PROFILE=./config/gateway.harness.json
HARNESS_ARTIFACTS_DIR=./artifacts/test
HARNESS_FIXTURES_DIR=./fixtures
# HARNESS_STUB_LLM=1
# STT_PROVIDER=fixture   # CI default — never point harness at live OpenAI STT
# Production voice keys live in config/production/voice.env.example (PROD-03)
